/**
 * .env.example
 * 
 * 이 파일을 .env.local로 복사하고 실제 값을 입력하세요.
 * 절대 .env.local을 깃허브에 커밋하지 마세요!
 */

# Google Sheets Published XLSX URL
# 스프레드시트 > 파일 > 공유 > 웹에 게시 > 전체 문서, Microsoft Excel(.xlsx) 선택 후 URL 복사
NEXT_PUBLIC_PUBLISHED_XLSX_URL=https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_ID/pub?output=xlsx

# Google Sheets API 설정 (레거시, 사용 안 함)
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
GOOGLE_API_KEY=your_google_api_key_here

# 예시:
# NEXT_PUBLIC_PUBLISHED_XLSX_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQhFIcM9RRt_ysKkbY2fajvFzM0tR7qWaE0iiIND7hqj19F5QlBdsef7esYG2BvBdBMbCMAPsnRwB2s/pub?output=xlsx
# GOOGLE_SHEETS_ID=1pJ_example123xyz_abc
# GOOGLE_API_KEY=AIzaSyD_example123xyz_abc
